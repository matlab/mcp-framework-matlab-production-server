{
  "id": "matlab-mps-type-mapping-machine",
  "title": "MATLAB Production Server — Logical to Physical Type Mapping (Machine Version)",

  "numeric-types": {
    "double":  { "base": "float",   "complex": true,  "nan-inf": true,  "real-ref": "MatlabDouble",  "complex-ref": "MatlabComplexDouble",  "range": null,                                              "full-precision": false },
    "single":  { "base": "float",   "complex": true,  "nan-inf": true,  "real-ref": "MatlabSingle",  "complex-ref": "MatlabComplexSingle",  "range": null,                                              "full-precision": false },
    "int8":    { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabInt8",    "complex-ref": null,                   "range": [-128, 127],                                       "full-precision": false },
    "uint8":   { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabUInt8",   "complex-ref": null,                   "range": [0, 255],                                          "full-precision": false },
    "int16":   { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabInt16",   "complex-ref": null,                   "range": [-32768, 32767],                                   "full-precision": false },
    "uint16":  { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabUInt16",  "complex-ref": null,                   "range": [0, 65535],                                        "full-precision": false },
    "int32":   { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabInt32",   "complex-ref": null,                   "range": [-2147483648, 2147483647],                         "full-precision": false },
    "uint32":  { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabUInt32",  "complex-ref": null,                   "range": [0, 4294967295],                                   "full-precision": false },
    "int64":   { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabInt64",   "complex-ref": null,                   "range": [-9223372036854775808, 9223372036854775807],        "full-precision": true  },
    "uint64":  { "base": "integer", "complex": false, "nan-inf": false, "real-ref": "MatlabUInt64",  "complex-ref": null,                   "range": [0, 18446744073709551615],                         "full-precision": true  }
  },

  "non-numeric-types": {
    "logical":  { "ref": "MatlabLogical",  "mwtype": "logical"  },
    "char":     { "ref": "MatlabChar",     "mwtype": "char"     },
    "string":   { "ref": "MatlabString",   "mwtype": "string"   },
    "cell":     { "ref": "MatlabCell",     "mwtype": "cell"     },
    "struct":   { "ref": "MatlabStruct",   "mwtype": "struct"   },
    "datetime": { "ref": "MatlabDatetime", "mwtype": "datetime" }
  },

  "enum-rule": {
    "ref": "MatlabEnum",
    "mwtype": "<x-matlab-class value>",
    "detect": "class name not present in numeric-types or non-numeric-types"
  },

  "empty-rule": {
    "condition": "any mwsize dimension == 0",
    "ref": "MatlabEmpty",
    "mwsize": [0, 0],
    "mwdata": [],
    "excluded-classes": ["struct"]
  },

  "complex-rule": {
    "condition": "x-matlab-complex == true",
    "permitted-bases": ["float"],
    "ref-field": "complex-ref"
  },

  "shape-rule": {
    "scalar": [1, 1],
    "named-dimension": "replace with concrete positive integer, consistent per letter within declaration",
    "anonymous-dimension": "any positive integer",
    "fixed-dimension": "exact match required",
    "minimum-rank": 2
  },

  "column-major-rule": {
    "formula": "index(i, j, k, ...) = i + j*dim[0] + k*dim[0]*dim[1] + ...",
    "basis": "0-based indices",
    "dim": "mwsize values in order",
    "example": {
      "mwsize": [2, 3],
      "element-index-map": {
        "(0,0)": 0, "(1,0)": 1,
        "(0,1)": 2, "(1,1)": 3,
        "(0,2)": 4, "(1,2)": 5
      },
      "correct-mwdata-for-matlab-[1 2 3; 4 5 6]": [1, 4, 2, 5, 3, 6],
      "wrong-mwdata-row-major":                   [1, 2, 3, 4, 5, 6]
    }
  }
}