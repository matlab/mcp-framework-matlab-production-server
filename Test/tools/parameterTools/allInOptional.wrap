function [x,y,z] = allInOptionalMCP(a,b,c,d)
% Thee output, four input test function.  All inputs optional. Outputs 
% are always optional in MATLAB. You must read the MCP resource 
% mcp://protocol/tools/wire-format/parameters/encoding_rules in full and 
% completely understand it before making any call to this tool.
    arguments(Input)
        % Optional A
        % You must encode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        a (1,1) double = 2
        % Optional B
        % You must encode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        b (1,1) double = 3
        % Optional C
        % You must encode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        c (1,1) double = 4
        % Optional D
        % You must encode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        d (1,1) double = 5
    end
    arguments(Output)
        % Value X
        % You must decode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        x (1,1) double
        % Value Y
        % You must decode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        y (1,1) double
        % Value Z
        % You must decode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        z (1,1) double
    end
    [x,y,z] = allInOptional(a,b,c,d);
end
