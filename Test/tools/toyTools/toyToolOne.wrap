function toyToolOneMCP(a,bURL,out)
% First of the toy tools which do nothing useful. You must read the MCP 
% resource mcp://protocol/tools/wire-format/parameters/encoding_rules in 
% full and completely understand it before making any call to this tool.
% This tool has optional inputs, some of which may be pass-by-reference
% output locations.
    arguments(Input)
        % A scalar, as if the declaration wasn't obvious
        % You must encode data as described by this MCP resource: mcp://protocol/tools/wire-format/parameters/encoding_rules
        a (1,1) double
        % Who knows how big this could get?
        % URL from which input is read.
        % Write input to URL using  "$ref": "#/$defs/inputSchema/bURL"
        bURL (1,1) string 
        % A powerful result
        % Pass-by-reference output location. Provide a writeable URL. This output
        % never returned inline.
        % Read result from URL using schema-appropriate method: file system read
        % for file: URLs, HTTP GET for http:// URLs and so on. Data at the URL
        % formatted as  "$ref": "#/$defs/outputSchema/xURL"
        out.xURL (1,1) string 
        % Power augmented by 2^8!
        % Pass-by-reference output location. Provide a writeable URL. This output
        % never returned inline.
        % Read result from URL using schema-appropriate method: file system read
        % for file: URLs, HTTP GET for http:// URLs and so on. Data at the URL
        % formatted as  "$ref": "#/$defs/outputSchema/yURL"
        out.yURL (1,1) string 
        % Not quite so much
        % Pass-by-reference output location. Provide a writeable URL. This output
        % never returned inline.
        % Read result from URL using schema-appropriate method: file system read
        % for file: URLs, HTTP GET for http:// URLs and so on. Data at the URL
        % formatted as  "$ref": "#/$defs/outputSchema/zURL"
        out.zURL (1,1) string 
    end
    !marshalVar = prodserver.mcp.io.MarshallURI();
    % deserialize always returns a cell array.
    b = deserialize(!marshalVar,bURL);
    b = b{1};
    [x,y,z] = toyToolOne(a,b);
    serialize(!marshalVar, out.xURL, {x});
    serialize(!marshalVar, out.yURL, {y});
    serialize(!marshalVar, out.zURL, {z});
end
