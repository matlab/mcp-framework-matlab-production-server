function [two] = toyToolThreeMCP(threeURL,twoURL,oneURL,out)
% I tell you three times. Thrice is nice. Just nonsense. And now a haiku 
% to test the fidelity of comment capture:  Whispers through the code, 
% Context flows—models connect, Understanding grows.  Brought to you, of 
% course, by an LLM.
% Some inputs to this tool are optional output locations: URLs where the
% server writes results. Provide a writable URL to receive each output.
    arguments(Input)
        % URL pointing to the input value for 'three'. The content of the URL is:
        % The first argument has the last name, numerically.
        % First or third?
        threeURL (1,1) string 
        % URL pointing to the input value for 'two'. The content of the URL is:
        % This argument is an immovable object. Whence the
        % unstoppable force?
        % Always second.
        twoURL (1,1) string 
        % URL pointing to the input value for 'one'. The content of the URL is:
        % Many words and fewer lines in this comment.
        % All of it nonsense, just here to make sure that MCP
        % Tools generated by this support package include every line.
        % Literally every line. Can't skip a single one. What if we did?
        % A disaster, no doubt. Who knows what information would be lost?
        % But with this test, we're sure to capture everything.
        % Still number one!
        oneURL (1,1) string 
        % URL pointing to the output value for 'one'. This value never returned
        % inline. Read result from URL using scheme-appropriate method: file
        % system read for file: URLs, HTTP GET for http:// URLs and so on. The
        % content of the URL is:
        % The first of all things
        out.oneURL (1,1) string  = ""
        % URL pointing to the output value for 'three'. This value never returned
        % inline. Read result from URL using scheme-appropriate method: file
        % system read for file: URLs, HTTP GET for http:// URLs and so on. The
        % content of the URL is:
        % Tripled in size and strength
        out.threeURL (1,1) string  = ""
    end
    arguments(Output)
        % One longer comment in the middle of a list of shorter ones.
        % It's a surprise!
        % Clone, doppelganger, twin
        two (1,1) struct
    end
    !marshalVar = prodserver.mcp.io.MarshallURI();
    % deserialize always returns a cell array.
    three = deserialize(!marshalVar,threeURL);
    three = three{1};
    two = deserialize(!marshalVar,twoURL);
    two = two{1};
    one = deserialize(!marshalVar,oneURL);
    one = one{1};
    [one,two,three] = toyToolThree(three,two,one);
    if strlength(out.oneURL) > 0
        serialize(!marshalVar, out.oneURL, {one});
    end
    if strlength(out.threeURL) > 0
        serialize(!marshalVar, out.threeURL, {three});
    end
end
