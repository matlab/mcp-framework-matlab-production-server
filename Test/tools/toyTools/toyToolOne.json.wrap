function toyToolOneMCP(a,bURL,out)
% First of the toy tools which do nothing useful.
% Some inputs to this tool are optional output locations: URLs where the
% server writes results. Provide a writable URL to receive each output.
    arguments(Input)
        % A scalar, as if the declaration wasn't obvious
        a (1,1) double
        % URL pointing to the input value for 'b'. The content of the URL is:
        % Who knows how big this could get?
        bURL (1,1) string 
        % URL pointing to the output value for 'x'. This value never returned
        % inline. Read result from URL using scheme-appropriate method: file
        % system read for file: URLs, HTTP GET for http:// URLs and so on. The
        % content of the URL is:
        % A powerful result
        out.xURL (1,1) string  = ""
        % URL pointing to the output value for 'y'. This value never returned
        % inline. Read result from URL using scheme-appropriate method: file
        % system read for file: URLs, HTTP GET for http:// URLs and so on. The
        % content of the URL is:
        % Power augmented by 2^8!
        out.yURL (1,1) string  = ""
        % URL pointing to the output value for 'z'. This value never returned
        % inline. Read result from URL using scheme-appropriate method: file
        % system read for file: URLs, HTTP GET for http:// URLs and so on. The
        % content of the URL is:
        % Not quite so much
        out.zURL (1,1) string  = ""
    end
    !marshalVar = prodserver.mcp.io.MarshallURI();
    % deserialize always returns a cell array.
    b = deserialize(!marshalVar,bURL);
    b = b{1};
    [x,y,z] = toyToolOne(a,b);
    if strlength(out.xURL) > 0
        serialize(!marshalVar, out.xURL, {x});
    end
    if strlength(out.yURL) > 0
        serialize(!marshalVar, out.yURL, {y});
    end
    if strlength(out.zURL) > 0
        serialize(!marshalVar, out.zURL, {z});
    end
end
