function toyToolTwoMCP(objectURL,mirrorURL,out)
% Are the object and the mirror chiral or achiral? If achiral, what is 
% the first orientation-reversing asymmetry? You must read the MCP 
% resource mcp://protocol/tools/wire-format/parameters/encoding_rules in 
% full and completely understand it before making any call to this tool.
% This tool has optional inputs, some of which may be pass-by-reference
% output locations.
    arguments(Input)
        % A geometrical form
        % URL from which input is read.
        % Write input to URL using  "$ref": "#/$defs/inputSchema/objectURL"
        objectURL (1,1) string 
        % The planar mirror reflection of object
        % URL from which input is read.
        % Write input to URL using  "$ref": "#/$defs/inputSchema/mirrorURL"
        mirrorURL (1,1) string 
        % True if mirror can be rotated to match object
        % Pass-by-reference output location. Provide a writeable URL. This output
        % never returned inline.
        % Read result from URL using schema-appropriate method: file system read
        % for file: URLs, HTTP GET for http:// URLs and so on. Data at the URL
        % formatted as  "$ref": "#/$defs/outputSchema/chiralURL"
        out.chiralURL (1,1) string  = ""
        % The asymmetry number if not
        % Pass-by-reference output location. Provide a writeable URL. This output
        % never returned inline.
        % Read result from URL using schema-appropriate method: file system read
        % for file: URLs, HTTP GET for http:// URLs and so on. Data at the URL
        % formatted as  "$ref": "#/$defs/outputSchema/asymmetryURL"
        out.asymmetryURL (1,1) string  = ""
    end
    !marshalVar = prodserver.mcp.io.MarshallURI();
    % deserialize always returns a cell array.
    object = deserialize(!marshalVar,objectURL);
    object = object{1};
    mirror = deserialize(!marshalVar,mirrorURL);
    mirror = mirror{1};
    [chiral,asymmetry] = toyToolTwo(object,mirror);
    if strlength(out.chiralURL) > 0
        serialize(!marshalVar, out.chiralURL, {chiral});
    end
    if strlength(out.asymmetryURL) > 0
        serialize(!marshalVar, out.asymmetryURL, {asymmetry});
    end
end
